class Solution {
public:
    int heightChecker(vector<int>& heights) {
        vector<int>expected=heights;
        int idx=0;
        sort(heights.begin(),heights.end());
        int j=0;
        for(int i=0;i<heights.size();i++)
        {
            if(j<expected.size())
            {
                if(heights[i]!=expected[j])
                {
                    idx++;
                    j++;
                }
                else{
                    j++;
                    continue;
                }
            }
        }
        return idx;
    }
};
