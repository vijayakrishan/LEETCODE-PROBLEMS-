class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        unordered_set<int>st;
        int longest =0;
        for(auto x:nums)
        {
            st.insert(x);
        }
        for(auto x:st)
        {
            if(st.find(x-1)==st.end())
            {
                int current=x;
                int length=1;
                while(st.find(current+1)!=st.end())
                {
                    current++;
                    length++;
                }
                longest=max(longest,length);
            }
        }
        return longest;
    }
};
