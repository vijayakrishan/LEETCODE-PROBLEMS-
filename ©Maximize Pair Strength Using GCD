class Solution {
public:
    int gcd(int a,int b)
    {
        if(b==0)
            return a;
        return gcd(b,a%b);
    }
    long long maxPairStrength(vector<int>& nums) {
        long long strength=LLONG_MIN;
        for(int i=0;i<nums.size()-1;i++)
            {
            for(int j=i+1;j<nums.size();j++)
                {
                    long long a=nums[i];
                long long sq=a*nums[j];
                long long gcd_=gcd(nums[i],nums[j]);  
                long long gcd_sq=gcd_*gcd_;
                long long temp=sq/gcd_sq;
                strength=max(strength,temp);  
                }
            }
        return strength;
    }
};©leetcode
