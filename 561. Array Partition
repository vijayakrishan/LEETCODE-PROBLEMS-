class Solution {
public:
    int arrayPairSum(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int max_num=0;
        int min1=0;
        int i=0;
        int j=i+1;
        while(i<nums.size()&&j<nums.size())
        {
            min1=min(nums[i],nums[j]);
            max_num+=min1;
            i+=2;
            j+=2;
        }
        return max_num;
    }
};
