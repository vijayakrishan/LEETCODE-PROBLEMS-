class Solution {
public:
    vector<int> applyOperations(vector<int>& nums) {
        vector<int>ans;
        for(int i=0;i<nums.size()-1;i++)
        {
           if(nums[i]==nums[i+1])
           {
            int temp=nums[i]*2;
            ans.push_back(temp);
            nums[i+1]=0;
           }
           else{
            ans.push_back(nums[i]);
           }
        }
        ans.push_back(nums[nums.size()-1]);//to push last elem into ans
        int j=0;
        for(int i=0;i<ans.size();i++)
        {
            if(ans[i]!=0)
            {
                ans[j]=ans[i];
                j++;
            }
        }
        while(j<ans.size())
        {
            ans[j]=0;
            j++;
        }
        return ans;
    }
};

