class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        vector<int>ans(nums.begin(),nums.end());
      for(int i=0;i<nums.size();i++)
      {
        if(nums[i]==target)
        {
            return i;
        }
        else if(nums[i]>target)
        {
            ans.push_back(target);
            sort(ans.begin(),ans.end());
            for(int i=0;i<ans.size();i++)
            {
                if(ans[i]==target)
                {
                    return i;
                }
            }
        }
      }
      return ans.size();
    }
};
