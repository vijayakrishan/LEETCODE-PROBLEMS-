class Solution {
public:
    int mostFrequentEven(vector<int>& nums) {
        map<int,int>mp;
        int min_elem=INT_MAX;
        int freq=INT_MIN;
        for(int i=0;i<nums.size();i++)
        {
            mp[nums[i]]++;
        }
        for(auto x:mp)
        {
            if(x.first%2==0)
            {
                freq=max(freq,x.second);   
            }
        }
        for(auto x:mp)
        {
            if(x.first%2==0&&x.second==freq)
            {
                min_elem=min(min_elem,x.first);
            }
        }
        if(min_elem!=INT_MAX)
        return min_elem;
        return -1;
    }
};
