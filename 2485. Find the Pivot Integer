class Solution {
public:
    int pivotInteger(int n) {
        int x=1;
        int sum1;
        int sum2;
        while(x<=n)
        {
            sum1=0;
            sum2=0;
            for(int i=1;i<=x;i++)
            {
                sum1+=i;
            }
            for(int i=x;i<=n;i++)
            {
                sum2+=i;
            }
            if(sum1==sum2)
            return x;
            x++;
        }
        if(sum1==sum2)
        return x;
        return -1;
    }
};
