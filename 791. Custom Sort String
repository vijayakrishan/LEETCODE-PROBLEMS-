class Solution {
public:
    string customSortString(string order, string s) {
        vector<char>temp(s.begin(),s.end());
        string ans="";
        for(int i=0;i<order.size();i++)
        {
            for(int j=0;j<s.size();j++)
            {
                if(order[i]==s[j])
                {
                    ans+=s[j];
                auto it=find(temp.begin(),temp.end(),s[j]);
                if(it!=temp.end())
                {
                    temp.erase(it);
                }
                }
            }
        }
        for(int i=0;i<temp.size();i++)
        {
            ans+=temp[i];
        }
        return ans;
    }
};
