class Solution {
public:
    long long removeZeros(long long n) {
        string temp=to_string(n);
        string ans="";
        for(int i=0;i<temp.size();i++)
        {
            if(temp[i]!='0')
            ans+=temp[i];
        }
        long long decimal_rep=stoll(ans);
        return decimal_rep;
    }
};
